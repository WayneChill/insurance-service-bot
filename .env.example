# LINE Bot 設定（從 LINE Developers Console 取得）
LINE_CHANNEL_SECRET=你的_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=你的_access_token

# Google Sheets 設定
GOOGLE_CREDENTIALS_FILE=credentials.json   # Service Account JSON 檔案路徑
GOOGLE_SHEET_ID=你的_spreadsheet_id        # Google Sheet 網址中間那段 ID

# 伺服器 Port（Railway 會自動注入，本地測試用 5000）
PORT=5000

# 保險業務平台安全橋接
SITE_BASE_URL=https://claims-assistant.waynechiuchiu.chatgpt.site
LINE_BRIDGE_SECRET=請使用高強度隨機值並與網站端設定相同

# 舊版 Dashboard API 預設停用；只有明確需要時才開啟
ENABLE_LEGACY_DASHBOARD=false
